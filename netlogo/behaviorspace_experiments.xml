  <experiment name="05-baseline-empirical-threshold-ER" repetitions="24" sequentialRunOrder="true" runMetricsEveryStep="false">
    <setup>set bs-collect-metrics? true
set bs-prev-samples []
set immunization-strategy "none"
set immunized-fraction 0
set recovery-distribution "exponential"
